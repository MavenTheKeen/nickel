{
  "name": "nickel",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@react-native-community/datetimepicker": "9.1.0",
    "@sentry/react-native": "7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "5.104.5",
    "expo": "57.0.30",
    "expo-asset": "57.0.20",
    "expo-background-task": "57.0.21",
    "expo-constants": "57.0.22",
    "expo-crypto": "57.0.4",
    "expo-dev-client": "57.0.20",
    "expo-document-picker": "57.0.3",
    "expo-file-system": "57.0.7",
    "expo-font": "57.0.4",
    "expo-haptics": "57.0.3",
    "expo-image-picker": "57.0.20",
    "expo-linking": "57.0.13",
    "expo-local-authentication": "57.0.3",
    "expo-localization": "57.0.2",
    "expo-notifications": "57.0.23",
    "expo-quick-actions": "6.0.2",
    "expo-router": "57.0.28",
    "expo-secure-store": "57.0.4",
    "expo-sharing": "57.0.23",
    "expo-sqlite": "57.0.4",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "expo-task-manager": "57.0.21",
    "expo-text-extractor": "2.0.0",
    "expo-updates": "57.0.26",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.90.0",
    "react-native": "0.86.3",
    "react-native-android-widget": "0.22.1",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.10.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.14",
    "@types/node": "24.19.2",
    "@types/react": "19.2.18",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "eslint-config-prettier": "10.1.8",
    "jest": "29.7.0",
    "jest-expo": "57.0.6",
    "prettier": "3.9.10",
    "test-renderer": "1.2.0",
    "typescript": "6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "analyze:ab": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/analyze-ab.mts",
    "audit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/audit.mts"
  },
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.tsx"
    ],
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.ts?(x)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@shopify/flash-list)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/app/**",
      "!**/*.d.ts"
    ],
    "coverageReporters": [
      "text-summary",
      "lcov"
    ]
  }
}
